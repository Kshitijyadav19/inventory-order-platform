# Local Docker Compose values; replace all secrets
POSTGRES_PASSWORD=CHANGE_THIS_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_THIS_LONG_RANDOM_PASSWORD@db:5432/inventory_db
JWT_SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe_48
